# ================================
# macOS
# ================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ================================
# Node.js / npm
# ================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ================================
# TypeScript
# ================================
dist/
build/
out/
*.js.map
*.d.ts
# Exception: manually authored ambient declarations
!tests/types/*.d.ts
tsconfig.tsbuildinfo

# ================================
# dotenv
# ================================
.env
.env.*
!.env.example
!.env.template

# Allow Git to track the tests/.env/ directory
!tests/.env/
# Ignore everything inside that directory
tests/.env/*
# Exception: Track this specific file
!tests/.env/.env.example

# ================================
# Playwright
# ================================
/tests/test-results/
/tests/playwright-report/
/tests/playwright/.cache/
/tests/blob-report/
/tests/coverage/
runtime-artifacts/

# ================================
# Editor & IDE
# ================================
.vscode/
.cursorrules
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ================================
# Logs & temp
# ================================
logs/
*.log
tmp/
temp/
.cache/

# ================================
# Runtime / OS
# ================================
pids/
*.pid
*.seed
*.pid.lock

# ================================
# AI Tooling (local only)
# ================================
.claude/
.mcp.json
test-results/.last-run.json
