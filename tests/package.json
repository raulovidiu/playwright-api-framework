{
	"name": "playwright-api-framework",
	"version": "1.0.0",
	"type": "module",
	"description": "Playwright API Tests Framework",
	"scripts": {
		"lint": "biome check ./tests",
		"fix": "biome check --write ./tests",
		"format": "biome format --write ./tests",
		"test": "playwright test",
		"test:headed": "playwright test --headed",
		"test:ui": "playwright test --ui",
		"test:api": "playwright test tests/api-layer",
		"test:e2e": "playwright test tests/e2e",
		"test:report": "playwright show-report"
	},
	"devDependencies": {
		"typescript": "7.0.2",
		"@playwright/test": "^1.61.1",
		"@biomejs/biome": "^2.5.4"
	},
	"dependencies": {
		"dotenv": "17.4.2",
		"cross-env": "10.1.0",
		"zod": "4.4.3",
		"@faker-js/faker": "10.5.0",
		"@types/node": "26.1.1"
	}
}
